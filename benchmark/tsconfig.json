{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "types": ["node"],
    "declaration": false,
    "rootDir": "src",
    "outDir": ".build",
    "noEmit": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", ".build", "results"]
}
